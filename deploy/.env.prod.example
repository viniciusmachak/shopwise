# Copy to deploy/.env.prod on the server and fill in. Never commit the real file.

# Public address. Caddy gets the HTTPS certificate for SHOPWISE_DOMAIN automatically.
SHOPWISE_DOMAIN=shopwise.example.duckdns.org
SHOPWISE_PUBLIC_URL=https://shopwise.example.duckdns.org

# Database
POSTGRES_PASSWORD=change-me

# Demo site: load the sample catalog, photos and coupons. Remove this line for a real store
# before the first start (it can't be undone by removing it later).
SHOPWISE_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# Assistant: cloud (Gemini, then Groq) or local (Ollama only). Set at least one key for cloud.
# Keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
SHOPWISE_AI_CHAT_MODE=cloud
GEMINI_API_KEY=
GROQ_API_KEY=
# true also downloads the local chat model (about 5 GB) and uses it when the cloud fails.
# Too slow on a 2-core VM, so it's off here. Embeddings always run on Ollama.
SHOPWISE_AI_FALLBACK_TO_LOCAL=false
SHOPWISE_OLLAMA_CHAT_MODEL=qwen2.5:7b

# Grafana (reach it through an SSH tunnel: ssh -L 3000:localhost:3000 <vm>, then http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=change-me-too

# Backoffice admins (comma-separated e-mails)
SHOPWISE_ADMIN_EMAILS=

# E-mail (e.g. Brevo or Resend SMTP)
SHOPWISE_MAIL_HOST=
SHOPWISE_MAIL_PORT=587
SHOPWISE_MAIL_USERNAME=
SHOPWISE_MAIL_PASSWORD=
SHOPWISE_MAIL_FROM=Shopwise <no-reply@example.com>

# Sign in with Google (optional). Redirect URI: https://<SHOPWISE_DOMAIN>/login/oauth2/code/google
# Leave these commented out unless you have the values: empty ones stop the backend from starting.
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=openid,email,profile

# Off-site backups (optional, docker compose --profile offsite)
BACKUP_KEEP_DAYS=7
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=shopwise-backups

# Image tag to run (a commit SHA from CI, or latest)
SHOPWISE_TAG=latest

# Card payments with Stripe Checkout (optional; payments are simulated without a key).
# Test keys start with sk_test_; the webhook secret (whsec_) comes from the webhook endpoint,
# or locally from: stripe listen --forward-to localhost:8080/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
