# Copy to .env and fill in. Without cloud keys the assistant runs in local mode.
SHOPWISE_AI_CHAT_MODE=local
GEMINI_API_KEY=
GROQ_API_KEY=
SHOPWISE_OLLAMA_CHAT_MODEL=qwen2.5:7b

# Sign in with Google (optional). Create an OAuth client at console.cloud.google.com with
# redirect URI http://localhost:5173/login/oauth2/code/google (the Vite dev server proxies it
# to the backend), then uncomment:
# spring.security.oauth2.client.registration.google.client-id=
# spring.security.oauth2.client.registration.google.client-secret=
# spring.security.oauth2.client.registration.google.scope=openid,email,profile

# Comma-separated e-mails that get the admin role (backoffice)
SHOPWISE_ADMIN_EMAILS=

# Card payments with Stripe Checkout (optional; payments are simulated without a key).
# Test keys start with sk_test_; the webhook secret (whsec_) comes from the webhook endpoint,
# or locally from: stripe listen --forward-to localhost:8080/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
